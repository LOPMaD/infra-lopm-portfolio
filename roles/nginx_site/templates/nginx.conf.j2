server {
    listen 80 default_server;
    listen 443 ssl default_server;

    ssl_certificate     /etc/letsencrypt/live/lopm.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lopm.space/privkey.pem;

    return 444;
}

server {
    listen 80;
    server_name lopm.space www.lopm.space;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name lopm.space www.lopm.space;
    http2 on;

    ssl_certificate     /etc/letsencrypt/live/lopm.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lopm.space/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
    }
}

server {
    listen 443 ssl;
    server_name containers.lopm.space;
    http2 on;

    ssl_certificate     /etc/letsencrypt/live/lopm.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lopm.space/privkey.pem;

